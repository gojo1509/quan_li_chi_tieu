<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHI TIẾT CHI TIÊU"
            android:textColor="#1976D2"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtChiTietTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtChiTietSoTien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtChiTietDanhMuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#222222"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày chi"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtChiTietNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#222222"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtChiTietGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không có ghi chú"
            android:textSize="17sp"
            android:textColor="#222222"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnQuayLai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay lại"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnXoaChiTieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xóa khoản chi"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F" />

    </LinearLayout>

</ScrollView>
