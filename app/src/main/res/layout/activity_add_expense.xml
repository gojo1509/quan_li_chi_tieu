<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM KHOẢN CHI"
            android:textColor="#1976D2"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi *"
            android:textColor="#333333"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtTenKhoanChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: Ăn trưa"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền (VNĐ) *"
            android:textColor="#333333"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtSoTien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số tiền"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục *"
            android:textColor="#333333"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spnDanhMuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày chi *"
            android:textColor="#333333"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnChonNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn ngày"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textColor="#333333"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú nếu có"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnLuuChiTieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu khoản chi"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
